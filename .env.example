# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Agent LLM (required) ---------------------------------------------------
# One of: openai | anthropic | ollama
LLM_PROVIDER=ollama
# Model name for that provider, e.g. llama3.2:3b (ollama), claude-haiku-5-5
# (anthropic), or any OpenAI chat model. There is no default in code on purpose.
LLM_MODEL=llama3.2:3b
# Sampling temperature and seed (seed is honoured by ollama/openai)
LLM_TEMPERATURE=0
LLM_SEED=42

# Only needed for the matching provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama server URL (defaults to http://localhost:11434 when unset)
OLLAMA_BASE_URL=

# --- Optional LLM-judge suite (DeepEval) -----------------------------------
# Runs only when the judge provider is openai/anthropic and its key is set.
# Defaults to LLM_PROVIDER / LLM_MODEL when unset.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_THRESHOLD=0.7

# --- Retrieval ---------------------------------------------------------------
# Where evals/build_index.py writes the ChromaDB index (default: .chroma)
CHROMA_DIR=.chroma
